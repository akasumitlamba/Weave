<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper_white"
    android:gravity="center_vertical"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/charcoal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noteMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/noteMenu"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:gravity="center"
        android:text="@string/more_menu"
        android:textColor="@color/charcoal"
        android:textSize="20sp"
        android:contentDescription="@string/more_menu" />
</LinearLayout>
