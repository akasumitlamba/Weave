<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Weave" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_selection</item>
        <item name="colorPrimaryContainer">#D3E8CB</item>
        <item name="colorOnPrimaryContainer">#102014</item>
        <item name="colorOnSurface">#202A20</item>
        <item name="colorOnSurfaceVariant">#53604E</item>
        <item name="colorSurface">#F4F7F0</item>
        <item name="colorSurfaceContainer">#E8EFE2</item>
        <item name="colorOutlineVariant">#C3CDBB</item>
        <item name="colorOnPrimary">@color/paper_white</item>
        <item name="colorSecondary">@color/charcoal</item>
        <item name="android:statusBarColor">@color/workspace_bg</item>
        <item name="android:navigationBarColor">@color/workspace_bg</item>
        <item name="android:windowBackground">@color/workspace_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Weave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/weave_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Weave</item>
    </style>
</resources>
