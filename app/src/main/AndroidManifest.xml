<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weave is offline-only: no INTERNET or network permissions. -->

    <application
        android:name=".WeaveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weave"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditorActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:label="@string/default_note_title" />

        <!-- Kept for debug deep-links / older evidence; not the launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Debug input probe; activity self-finishes in non-debug builds. -->
        <activity
            android:name=".input.InputProbeActivity"
            android:exported="false"
            android:label="@string/input_probe_title"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>
</manifest>
